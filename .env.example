# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# App URL
APP_URL=http://localhost:3000

# Local SQLite by default; use your libsql:// URL for Turso
DATABASE_URL=file:data/portal.db

# Required for Turso; leave empty for local SQLite
TURSO_AUTH_TOKEN=

# Daily Vercel refresh; use a random value of at least 32 characters.
CRON_SECRET=
# Set false to pause collection while keeping the last successful snapshot.
WOSGURU_SYNC_ENABLED=true
